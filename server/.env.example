# Supabase（Project Settings -> API）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: only if you need admin (service role) operations
SUPABASE_SERVICE_ROLE_KEY=

# LLM credentials (any OpenAI-compatible provider)
# Default (OpenAI): only set OPENAI_API_KEY
# Doubao / Ark example:
#   OPENAI_API_KEY=<Ark API Key>
#   OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=<doubao model id or endpoint id, e.g. doubao-seed-2-0-mini-260215 / ep-xxxx>
# DeepSeek example:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- 火山引擎语音服务（TTS 合成 + ASR 录音文件识别极速版）----
# 控制台 -> 语音技术 -> 创建应用（同一应用勾选 TTS 与 ASR）
# 应用详情页可拿 AppID 与 Access Token；TTS/ASR 的 Cluster ID 也在应用详情
VOLC_APP_ID=your-volc-appid
VOLC_ACCESS_TOKEN=your-volc-access-token
# TTS 集群：标准音色固定 volcano_tts
TTS_CLUSTER=volcano_tts
# TTS 音色：免费音色 BV001_streaming(通用女声) / BV002_streaming(通用男声)，其余音色需控制台 0 元下单
TTS_VOICE=BV001_streaming
# ASR 集群：控制台应用详情显示的录音文件识别极速版 Cluster ID（形如 volcano_auc_xxx）
ASR_CLUSTER=volcano_auc

# Server port (local dev only; Vercel injects its own)
PORT=9091
