# Supabase（Project Settings -> API）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: only if you need admin (service role) operations
SUPABASE_SERVICE_ROLE_KEY=

# LLM credentials (any OpenAI-compatible provider)
# Default (OpenAI): only set OPENAI_API_KEY
# Doubao / Ark example:
#   OPENAI_API_KEY=<Ark API Key>
#   OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=<doubao model id or endpoint id, e.g. doubao-seed-2-0-mini-260215 / ep-xxxx>
# DeepSeek example:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- 火山引擎语音服务（TTS 豆包语音合成2.0 + ASR 豆包录音文件识别2.0）----
# 新版控制台（推荐）：只用一个 API Key —— 控制台 -> 语音服务 -> API Key 管理
VOLC_API_KEY=（新版单Key鉴权：豆包语音服务API Key，与VOLC_APP_ID/VOLC_ACCESS_TOKEN二选一）
# 旧版控制台（备选）：应用详情页拿 AppID 与 Access Token
VOLC_APP_ID=your-volc-appid
VOLC_ACCESS_TOKEN=your-volc-access-token
# TTS：豆包语音合成大模型 2.0（X-Api-Resource-Id: seed-tts-2.0）
# 音色 ID：控制台「豆包语音合成模型 2.0」→ 音色库 → 复制音色 ID（必填，如 zh_female_XXX）
TTS_VOICE=zh_female_XXX
# ASR：豆包录音文件识别大模型 2.0（X-Api-Resource-Id: volc.seedasr.auc，鉴权与 TTS 相同）
# 无需额外变量；应用需开通「豆包录音文件识别模型2.0」服务（应用管理 -> 接入能力）

# Server port (local dev only; Vercel injects its own)
PORT=9091
