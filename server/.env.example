# Supabase（Project Settings -> API）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: only if you need admin (service role) operations
SUPABASE_SERVICE_ROLE_KEY=

# LLM credentials (any OpenAI-compatible provider)
# Default (OpenAI): only set OPENAI_API_KEY
# Doubao / Ark example:
#   OPENAI_API_KEY=<Ark API Key>
#   OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=<doubao model id or endpoint id, e.g. doubao-seed-1-6-250615 / ep-xxxx>
# DeepSeek example:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# TTS / ASR are OpenAI-native endpoints (Doubao TTS uses a different protocol).
# To use Doubao TTS later, voice.ts needs a separate adapter.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
ASR_MODEL=whisper-1

# Server port (local dev only; Vercel injects its own)
PORT=9091
