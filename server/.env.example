# Supabase（Project Settings -> API）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: only if you need admin (service role) operations
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (chat + TTS + ASR)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
ASR_MODEL=whisper-1

# Server port (local dev only; Vercel injects its own)
PORT=9091
